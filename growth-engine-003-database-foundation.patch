diff --git a/tests/test_database.py b/tests/test_database.py
new file mode 100644
index 0000000..0d09bf0
--- /dev/null
+++ b/tests/test_database.py
@@ -0,0 +1,98 @@
+from pathlib import Path
+
+import pytest
+from alembic import command
+from alembic.config import Config
+from sqlalchemy import Engine
+from sqlalchemy.orm import Session, sessionmaker
+
+from app.config.settings import Settings, settings
+from app.db.base import Base
+from app.db.session import get_db, get_engine, get_session_factory
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+
+
+def test_settings_exposes_database_url() -> None:
+    assert isinstance(settings.database_url, str)
+    assert settings.database_url
+
+
+def test_database_url_is_configurable(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("DATABASE_URL", "sqlite:///./custom.db")
+    fresh = Settings(_env_file=None)
+    assert fresh.database_url == "sqlite:///./custom.db"
+
+
+def test_base_imports_successfully() -> None:
+    assert hasattr(Base, "metadata")
+
+
+def test_no_domain_tables_registered_yet() -> None:
+    # PATCH 004 introduces domain models; nothing should be registered here.
+    assert Base.metadata.tables == {}
+
+
+def test_engine_can_be_constructed_without_connecting() -> None:
+    get_engine.cache_clear()
+    engine = get_engine()
+    try:
+        assert isinstance(engine, Engine)
+        # The pool must not have opened a real connection yet.
+        assert engine.pool.checkedout() == 0
+    finally:
+        engine.dispose()
+        get_engine.cache_clear()
+
+
+def test_session_factory_can_be_created() -> None:
+    get_session_factory.cache_clear()
+    factory = get_session_factory()
+    try:
+        assert isinstance(factory, sessionmaker)
+    finally:
+        get_session_factory.cache_clear()
+        get_engine.cache_clear()
+
+
+def test_get_db_yields_a_session(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(settings, "database_url", "sqlite:///:memory:")
+    get_engine.cache_clear()
+    get_session_factory.cache_clear()
+    try:
+        gen = get_db()
+        db = next(gen)
+        assert isinstance(db, Session)
+        with pytest.raises(StopIteration):
+            next(gen)
+    finally:
+        get_session_factory.cache_clear()
+        get_engine.cache_clear()
+
+
+def test_importing_app_main_does_not_require_a_database() -> None:
+    # Import must succeed with no database reachable; app.main never
+    # constructs an engine or opens a connection at import time.
+    import app.main
+
+    assert app.main.app is not None
+
+
+def test_alembic_config_imports_successfully() -> None:
+    cfg = Config(str(REPO_ROOT / "alembic.ini"))
+    assert cfg.get_main_option("script_location") == "alembic"
+
+
+def test_alembic_target_metadata_is_project_base(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    db_path = tmp_path / "alembic_test.db"
+    monkeypatch.setattr(settings, "database_url", f"sqlite:///{db_path}")
+
+    cfg = Config(str(REPO_ROOT / "alembic.ini"))
+    cfg.set_main_option("script_location", str(REPO_ROOT / "alembic"))
+
+    # Running env.py in offline/SQL mode exercises the real module
+    # (imports, target_metadata assignment) without requiring a live
+    # database connection or an external PostgreSQL server.
+    command.upgrade(cfg, "head", sql=True)
