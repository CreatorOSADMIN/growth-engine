+from sqlalchemy.orm import DeclarativeBase
+
+
+class Base(DeclarativeBase):
+    """Shared declarative base for all Growth Engine ORM models.
+
+    Domain models are added in PATCH 004 and later; this module only
+    provides the metadata foundation that Alembic and future models
+    depend on.
+    """
diff --git a/app/db/session.py b/app/db/session.py
new file mode 100644
index 0000000..6d4dcae
--- /dev/null
+++ b/app/db/session.py
@@ -0,0 +1,38 @@
+from collections.abc import Generator
+from functools import lru_cache
+
+from sqlalchemy import Engine, create_engine
+from sqlalchemy.orm import Session, sessionmaker
+
+from app.config.settings import settings
+
+
+@lru_cache
+def get_engine() -> Engine:
+    """Create (and cache) the SQLAlchemy engine.
+
+    The engine is built lazily on first use so that importing this
+    module - or app.main - never opens a database connection.
+    """
+    return create_engine(settings.database_url, pool_pre_ping=True)
+
+
+@lru_cache
+def get_session_factory() -> sessionmaker[Session]:
+    return sessionmaker(bind=get_engine(), autoflush=False, autocommit=False)
+
+
+def get_db() -> Generator[Session, None, None]:
+    """FastAPI-style dependency yielding a database session per request."""
+    session_factory = get_session_factory()
+    db = session_factory()
+    try:
+        yield db
+    finally:
+        db.close()
+
+
+def dispose_engine() -> None:
+    """Close all pooled connections. Intended for application shutdown."""
+    if get_engine.cache_info().currsize:
+        get_engine().dispose()
