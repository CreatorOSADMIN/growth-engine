index 0000000..1f41eed
--- /dev/null
+++ b/tests/test_models.py
@@ -0,0 +1,285 @@
+"""Tests for the PATCH 004 core domain models."""
+
+from datetime import datetime, timezone
+
+import pytest
+from sqlalchemy import create_engine, event
+from sqlalchemy.orm import Session
+
+from app.db.base import Base
+from app.db.models import Crawl, CrawlRequest, Domain, Link, Page, Project, Website
+
+EXPECTED_TABLES = {
+    "projects",
+    "websites",
+    "domains",
+    "pages",
+    "links",
+    "crawls",
+    "crawl_requests",
+}
+
+
+@pytest.fixture()
+def session():
+    engine = create_engine("sqlite:///:memory:")
+
+    @event.listens_for(engine, "connect")
+    def _enable_fk(dbapi_connection, _):
+        cursor = dbapi_connection.cursor()
+        cursor.execute("PRAGMA foreign_keys=ON")
+        cursor.close()
+
+    Base.metadata.create_all(engine)
+    with Session(engine) as db:
+        yield db
+    engine.dispose()
+
+
+def now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+# ---------------------------------------------------------------------------
+# 1-6: imports, table registration, PKs, FKs, relationships, constraints
+# ---------------------------------------------------------------------------
+
+
+def test_all_models_import_successfully() -> None:
+    for model in (Project, Website, Domain, Page, Link, Crawl, CrawlRequest):
+        assert hasattr(model, "__table__")
+
+
+def test_only_expected_tables_are_registered() -> None:
+    assert set(Base.metadata.tables) == EXPECTED_TABLES
+
+
+@pytest.mark.parametrize(
+    "table_name",
+    sorted(EXPECTED_TABLES),
+)
+def test_every_table_has_a_primary_key(table_name: str) -> None:
+    table = Base.metadata.tables[table_name]
+    assert len(table.primary_key.columns) == 1
+
+
+def test_foreign_keys_are_correctly_defined() -> None:
+    tables = Base.metadata.tables
+    fk_targets = {
+        "websites": {("project_id", "projects.id")},
+        "domains": {("project_id", "projects.id")},
+        "pages": {("domain_id", "domains.id")},
+        "links": {
+            ("source_page_id", "pages.id"),
+            ("target_domain_id", "domains.id"),
+            ("target_page_id", "pages.id"),
+        },
+        "crawls": {("project_id", "projects.id"), ("website_id", "websites.id")},
+        "crawl_requests": {("crawl_id", "crawls.id")},
+    }
+    for table_name, expected in fk_targets.items():
+        table = tables[table_name]
+        actual = {
+            (fk.parent.name, f"{fk.column.table.name}.{fk.column.name}")
+            for fk in table.foreign_keys
+        }
+        assert expected <= actual, f"{table_name}: expected {expected}, got {actual}"
+
+
+def test_expected_indexes_and_unique_constraints_exist() -> None:
+    tables = Base.metadata.tables
+
+    projects_unique_cols = {tuple(uc.columns.keys()) for uc in tables["projects"].constraints if hasattr(uc, "columns") and uc.__class__.__name__ == "UniqueConstraint"}
+    assert tables["projects"].columns["slug"].unique or tables["projects"].columns["slug"].index
+
+    websites_uniques = {
+        tuple(uc.columns.keys())
+        for uc in tables["websites"].constraints
+        if uc.__class__.__name__ == "UniqueConstraint"
+    }
+    assert ("project_id", "base_url") in websites_uniques
+
+    domains_uniques = {
+        tuple(uc.columns.keys())
+        for uc in tables["domains"].constraints
+        if uc.__class__.__name__ == "UniqueConstraint"
+    }
+    assert ("project_id", "hostname") in domains_uniques
+
+    assert tables["pages"].columns["normalized_url"].index
+    assert tables["pages"].columns["content_hash"].index
+    assert tables["pages"].columns["domain_id"].index
+    assert tables["pages"].columns["status_code"].index
+
+    assert tables["crawl_requests"].columns["normalized_url"].index
+    assert tables["crawl_requests"].columns["status"].index
+    assert tables["crawl_requests"].columns["depth"].index
+
+
+def test_pages_normalized_url_is_not_globally_unique() -> None:
+    # Deduplication is deliberately NOT enforced at the DB level so crawl
+    # history (PATCH 009) is not silently dropped.
+    table = Base.metadata.tables["pages"]
+    assert not table.columns["normalized_url"].unique
+    unique_col_sets = {
+        tuple(uc.columns.keys())
+        for uc in table.constraints
+        if uc.__class__.__name__ == "UniqueConstraint"
+    }
+    assert not any("normalized_url" in cols for cols in unique_col_sets)
+
+
+# ---------------------------------------------------------------------------
+# 7-10: relationship behavior against a real (SQLite) database
+# ---------------------------------------------------------------------------
+
+
+def test_project_to_website_relationship(session: Session) -> None:
+    project = Project(name="Acme", slug="acme")
+    website = Website(project=project, name="Main site", base_url="https://acme.com")
+    session.add(project)
+    session.commit()
+
+    assert website in project.websites
+    assert website.project is project
+
+
+def test_domain_to_page_relationship(session: Session) -> None:
+    project = Project(name="Acme", slug="acme-2")
+    domain = Domain(
+        project=project,
+        hostname="acme.com",
+        etld_plus_one="acme.com",
+        first_seen_at=now(),
+        last_seen_at=now(),
+    )
+    page = Page(
+        domain=domain,
+        url="https://acme.com/",
+        normalized_url="https://acme.com/",
+        first_seen_at=now(),
+        last_seen_at=now(),
+    )
+    session.add(project)
+    session.commit()
+
+    assert page in domain.pages
+    assert page.domain is domain
+
+
+def test_page_to_link_relationship(session: Session) -> None:
+    project = Project(name="Acme", slug="acme-3")
+    domain = Domain(
+        project=project,
+        hostname="acme.com",
+        etld_plus_one="acme.com",
+        first_seen_at=now(),
+        last_seen_at=now(),
+    )
+    page = Page(
+        domain=domain,
+        url="https://acme.com/",
+        normalized_url="https://acme.com/",
+        first_seen_at=now(),
+        last_seen_at=now(),
+    )
+    link = Link(
+        source_page=page,
+        target_url="https://acme.com/about",
+        normalized_target_url="https://acme.com/about",
+        is_internal=True,
+        discovered_at=now(),
+    )
+    session.add(project)
+    session.commit()
+
+    assert link in page.links
+    assert link.source_page is page
+
+
+def test_crawl_to_crawl_request_relationship(session: Session) -> None:
+    project = Project(name="Acme", slug="acme-4")
+    crawl = Crawl(project=project, crawl_type="target", status="pending")
+    request = CrawlRequest(
+        crawl=crawl,
+        url="https://acme.com/",
+        normalized_url="https://acme.com/",
+        depth=0,
+        status="pending",
+        discovered_at=now(),
+    )
+    session.add(project)
+    session.commit()
+
+    assert request in crawl.crawl_requests
+    assert request.crawl is crawl
+
+
+# ---------------------------------------------------------------------------
+# Cascade behavior
+# ---------------------------------------------------------------------------
+
+
+def test_deleting_project_cascades_to_website(session: Session) -> None:
+    project = Project(name="Acme", slug="acme-5")
+    Website(project=project, name="Main", base_url="https://acme.com")
+    session.add(project)
+    session.commit()
+
+    session.delete(project)
+    session.commit()
+
+    assert session.query(Website).count() == 0
+
+
+def test_crawl_website_set_null_on_website_delete(session: Session) -> None:
+    project = Project(name="Acme", slug="acme-6")
+    website = Website(project=project, name="Main", base_url="https://acme.com")
+    session.add(project)
+    session.commit()
+
+    crawl = Crawl(project=project, website=website, crawl_type="target", status="pending")
+    session.add(crawl)
+    session.commit()
+
+    session.delete(website)
+    session.commit()
+    session.refresh(crawl)
+
+    assert crawl.website_id is None
+
+
+# ---------------------------------------------------------------------------
+# Constraint enforcement
+# ---------------------------------------------------------------------------
+
+
+def test_project_name_is_required(session: Session) -> None:
+    from sqlalchemy.exc import IntegrityError
+
+    session.add(Project(name=None, slug="no-name"))  # type: ignore[arg-type]
+    with pytest.raises(IntegrityError):
+        session.commit()
+
+
+def test_project_slug_is_unique(session: Session) -> None:
+    from sqlalchemy.exc import IntegrityError
+
+    session.add(Project(name="Acme", slug="dup"))
+    session.commit()
+
+    session.add(Project(name="Acme 2", slug="dup"))
+    with pytest.raises(IntegrityError):
+        session.commit()
+
+
+def test_crawl_type_check_constraint_rejects_invalid_value(session: Session) -> None:
+    from sqlalchemy.exc import IntegrityError
+
+    project = Project(name="Acme", slug="acme-7")
+    session.add(project)
+    session.commit()
+
+    session.add(Crawl(project=project, crawl_type="not-a-real-type", status="pending"))
+    with pytest.raises(IntegrityError):
+        session.commit()
