+"""Website domain model: a configured owned website within a Project."""
+
+import uuid
+from typing import TYPE_CHECKING
+
+from sqlalchemy import ForeignKey, String, UniqueConstraint, Uuid
+from sqlalchemy.orm import Mapped, mapped_column, relationship
+
+from app.db.base import Base
+from app.db.models._mixins import TimestampMixin, UUIDPrimaryKeyMixin
+
+if TYPE_CHECKING:
+    from app.db.models.project import Project
+
+
+class Website(UUIDPrimaryKeyMixin, TimestampMixin, Base):
+    __tablename__ = "websites"
+    __table_args__ = (
+        # A given canonical base URL should only be configured once per project.
+        UniqueConstraint("project_id", "base_url", name="uq_websites_project_base_url"),
+    )
+
+    project_id: Mapped[uuid.UUID] = mapped_column(
+        Uuid(as_uuid=True), ForeignKey("projects.id", ondelete="CASCADE"), nullable=False, index=True
+    )
+    name: Mapped[str] = mapped_column(String(255), nullable=False)
+    # Canonical base URL (scheme + host, no trailing slash), normalized by the caller.
+    base_url: Mapped[str] = mapped_column(String(2048), nullable=False)
+
+    project: Mapped["Project"] = relationship("Project", back_populates="websites")
+
+    def __repr__(self) -> str:  # pragma: no cover - debug convenience
+        return f"Website(id={self.id!r}, base_url={self.base_url!r})"
