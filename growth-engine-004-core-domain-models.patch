+
+target_page_id/target_domain_id are nullable: the target may be an
+external page or an internal page that has not been crawled yet.
+Backlink analysis and rel-attribute scoring belong to PATCH 011.
+"""
+
+import uuid
+from datetime import datetime
+from typing import TYPE_CHECKING
+
+from sqlalchemy import Boolean, DateTime, ForeignKey, String, Text, Uuid
+from sqlalchemy.orm import Mapped, mapped_column, relationship
+
+from app.db.base import Base
+from app.db.models._mixins import CreatedAtMixin, UUIDPrimaryKeyMixin
+
+if TYPE_CHECKING:
+    from app.db.models.domain import Domain
+    from app.db.models.page import Page
+
+
+class Link(UUIDPrimaryKeyMixin, CreatedAtMixin, Base):
+    __tablename__ = "links"
+
+    source_page_id: Mapped[uuid.UUID] = mapped_column(
+        Uuid(as_uuid=True), ForeignKey("pages.id", ondelete="CASCADE"), nullable=False, index=True
+    )
+    target_url: Mapped[str] = mapped_column(String(2048), nullable=False)
+    normalized_target_url: Mapped[str] = mapped_column(String(2048), nullable=False, index=True)
+    anchor_text: Mapped[str | None] = mapped_column(Text, nullable=True)
+    # Raw space-separated rel tokens as found in the HTML, e.g. "nofollow sponsored".
+    rel: Mapped[str | None] = mapped_column(String(255), nullable=True)
+    is_internal: Mapped[bool] = mapped_column(Boolean, nullable=False, default=False)
+
+    # Resolved lazily by the crawler/analysis engines once the target is known.
+    target_domain_id: Mapped[uuid.UUID | None] = mapped_column(
+        Uuid(as_uuid=True), ForeignKey("domains.id", ondelete="SET NULL"), nullable=True, index=True
+    )
+    target_page_id: Mapped[uuid.UUID | None] = mapped_column(
+        Uuid(as_uuid=True), ForeignKey("pages.id", ondelete="SET NULL"), nullable=True, index=True
+    )
+
+    discovered_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), nullable=False)
+
+    source_page: Mapped["Page"] = relationship(
+        "Page", back_populates="links", foreign_keys=[source_page_id]
+    )
+    target_domain: Mapped["Domain | None"] = relationship(
+        "Domain", foreign_keys=[target_domain_id]
+    )
+    target_page: Mapped["Page | None"] = relationship("Page", foreign_keys=[target_page_id])
+
+    def __repr__(self) -> str:  # pragma: no cover - debug convenience
+        return f"Link(id={self.id!r}, normalized_target_url={self.normalized_target_url!r})"
