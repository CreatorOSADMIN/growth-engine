index 0000000..2a440d4
--- /dev/null
+++ b/tests/test_logging.py
@@ -0,0 +1,23 @@
+import logging
+
+import app.logging as app_logging
+
+
+def test_configure_logging_does_not_duplicate_handlers() -> None:
+    app_logging._CONFIGURED = False
+    root = logging.getLogger()
+    root.handlers.clear()
+
+    app_logging.configure_logging()
+    first_count = len(root.handlers)
+
+    app_logging.configure_logging()
+    second_count = len(root.handlers)
+
+    assert first_count == 1
+    assert second_count == 1
+
+
+def test_get_logger_returns_named_logger() -> None:
+    logger = app_logging.get_logger("test.logger")
+    assert logger.name == "test.logger"
